//@version=6
strategy("Synthetic momentum filter", initial_capital=10000, default_qty_type=strategy.fixed, default_qty_value=1, process_orders_on_close=true)
period=input.int(20,"Period",minval=4,maxval=100)
length=input.int(10,"Length",minval=1,maxval=100)
threshold=input.float(0,"Threshold",minval=-5,maxval=5)
fast=close-close[length]
slow=ta.sma(close,period)
if fast>threshold and close>slow
    strategy.entry("L",strategy.long)
else if fast < -threshold
    strategy.close("L")
plot(fast,"Fast")
plot(slow,"Slow")
plot(strategy.position_size,"Position")
